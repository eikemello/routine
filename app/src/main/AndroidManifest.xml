<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".RoutineApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Routine">

        <service
            android:name=".listener.NotificationListener"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">

            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activity.HomeActivity"
            android:exported="false" />
        <activity
            android:name=".activity.ConfigActivity"
            android:exported="false" />
        <activity
            android:name=".activity.TrackerConfigActivity"
            android:exported="false" />
        <activity
            android:name=".activity.HistoryActivity"
            android:exported="false" />

        <!-- Combined home screen widget: water, meal and expense.
             All in a single 4x3 widget. Not exported: the
             launcher gets to it through the system (explicit APPWIDGET_UPDATE
             broadcasts) and through this app's own PendingIntents. -->
        <receiver
            android:name=".widget.WidgetCombinedProvider"
            android:exported="false"
            android:label="@string/widget_combined_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.android.nls.routine.action.widget.ADD_WATER" />
                <action android:name="com.android.nls.routine.action.widget.SAVE_MEAL" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_combined_info" />
        </receiver>

        <!-- Routines home screen widget: a 2x3 grid with one tile per enabled
             routine tracker (workout, medication, supplement), each one marking
             the day done or not done in place; the tiles of the disabled
             routines stay hidden. Not exported, like the combined widget: the
             launcher gets to it through the system (explicit APPWIDGET_UPDATE
             broadcasts) and through this app's own PendingIntents. -->
        <receiver
            android:name=".widget.WidgetTrackerProvider"
            android:exported="false"
            android:label="@string/widget_tracker_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.android.nls.routine.action.widget.TOGGLE_TRACKER" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_tracker_info" />
        </receiver>
    </application>

</manifest>
