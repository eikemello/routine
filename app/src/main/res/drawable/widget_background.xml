<?xml version="1.0" encoding="utf-8"?>
<!-- Background of the home screen widgets: the solid card surface of the
     app with a hairline, so the widgets read like the home cards on any
     wallpaper. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface_1" />
    <corners android:radius="28dp" />
    <stroke
        android:width="1dp"
        android:color="@color/outline_subtle" />
</shape>
