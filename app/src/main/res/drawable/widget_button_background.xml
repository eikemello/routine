<?xml version="1.0" encoding="utf-8"?>
<!-- The quick-add buttons of the water widget: the glass background of the home
     card buttons, with a ripple so a tap is visible on the launcher. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/white_40">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/button_glass" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_border" />
        </shape>
    </item>
</ripple>
