<?xml version="1.0" encoding="utf-8"?>
<!-- Neutral widget button (meal slots, routine done control): the tonal surface of the app buttons, with a ripple so a tap is visible on the launcher. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/white_15">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_3" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</ripple>
