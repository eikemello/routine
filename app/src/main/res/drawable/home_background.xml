<?xml version="1.0" encoding="utf-8"?>
<!-- Screen background: the solid dark base with one soft white glow at the
     top, so the cards (surface_1) read as raised layers on top of it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/background" />
        </shape>
    </item>
    <item android:gravity="top|start">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="320dp"
                android:startColor="@color/white_08"
                android:endColor="@android:color/transparent" />
            <size
                android:width="560dp"
                android:height="440dp" />
        </shape>
    </item>
</layer-list>
