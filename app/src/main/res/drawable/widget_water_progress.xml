<?xml version="1.0" encoding="utf-8"?>
<!-- Progress of the water widget: same blue as the home card progress bar, in
     the shape a plain framework ProgressBar (the only one available inside
     RemoteViews) expects. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/neon_blue_1A" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/neon_blue" />
                <corners android:radius="4dp" />
            </shape>
        </clip>
    </item>
</layer-list>
