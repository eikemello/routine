<?xml version="1.0" encoding="utf-8"?><!-- One line of the All data list, shaped like the home cards: the type icon
     in its colored box on the left, the detail as title with the observation
     and the time under it, and the value as a tinted chip on the right. The
     observation, the time and the chip are the only optional pieces -
     settings rows carry no time, and rows without a value hide the chip. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="6dp">

        <ImageView
            android:id="@+id/imgRowIcon"
            style="@style/iconContainer"
            android:padding="4dp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtRowDetail"
                style="@style/subTitleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txtRowObservation"
                style="@style/subTitleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtRowTime"
                    style="@style/subTitleTextView.Muted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtRowNote"
                    style="@style/subTitleTextView.Muted"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/txtRowStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/chip_background"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="Completed"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="visible" />

        <ImageView
            android:id="@+id/imgRowArrow"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:alpha="0.5"
            android:src="@drawable/ic_chevron_right" />
    </LinearLayout>

    <View
        android:id="@+id/viewRowDivider"
        style="@style/divider" />
</LinearLayout>
