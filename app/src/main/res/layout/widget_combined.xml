<?xml version="1.0" encoding="utf-8"?><!--
  Combined home screen widget: the water card on top of the meal card, so both
  can be used without opening the app. Each section copies the cards of the
  home screen: the icon alone on the left, with the progress component, the
  numbers (today's total against the goal, or the meal slot of the current
  time of day - with a small check once it is logged - and the day's "x/4"
  count) and the three buttons grouped in the same box on its right, and a
  view line separating the two functionalities.

  It is rendered through RemoteViews, so it only uses framework views and the
  concrete color resources of the app (no Material components): a widget is
  inflated by the launcher, where the app theme is not necessarily available.
  The sample texts are only there for the picker preview - the provider always
  overwrites them with the real values before the widget is shown.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetWaterMealRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- ===================== WATER SECTION ===================== -->
    <!-- Copy of the home water card: the icon alone on the left, everything
         else in the same box on its right - the progress bar with today's
         total against the daily goal, then the three quick-add buttons. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imgWidgetWaterIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/icon_background_blue"
            android:contentDescription="@string/water"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_water" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ProgressBar
                    android:id="@+id/progressWidgetWater"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="317dp"
                    android:layout_height="6dp"
                    android:layout_alignParentStart="true"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="8dp"
                    android:layout_toStartOf="@+id/txtWidgetWaterDrank"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_water_progress" />

                <TextView
                    android:id="@+id/txtWidgetWaterDrank"
                    style="@style/widgetTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_toStartOf="@+id/txtWidgetWaterGoal"
                    android:text="@string/widget_water_preview_total" />

                <TextView
                    android:id="@+id/txtWidgetWaterGoal"
                    style="@style/widgetTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="4dp"
                    android:text="@string/widget_water_preview_goal" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal" >

                <TextView
                    android:id="@+id/btnWidgetAddWater1"
                    style="@style/widgetButton"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@string/add_water"
                    android:text="@string/widget_water_preview_button_50" />

                <TextView
                    android:id="@+id/btnWidgetAddWater2"
                    style="@style/widgetButton"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@string/add_water"
                    android:text="@string/widget_water_preview_button_100" />

                <TextView
                    android:id="@+id/btnWidgetAddWater3"
                    style="@style/widgetButton"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:contentDescription="@string/add_water"
                    android:text="@string/widget_water_preview_button_250" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- View line separating the two functionalities: water above, meals below.
         FrameLayout instead of a bare <View>: RemoteViews only inflates its
         allowlisted framework classes, and android.view.View is not one of
         them - a bare <View> throws "Class not allowed to be inflated" while
         the launcher applies the layout, so the widget cannot be added. -->
    <FrameLayout
        style="@style/divider"
        android:layout_width="match_parent" />

    <!-- ===================== MEAL SECTION ===================== -->
    <!-- Copy of the home meal card, with the same pattern as the water section:
         the icon alone on the left and, in the box on its right, the meal slot
         of the current time of day (with a small check once it is logged), the
         day's "x/4" count and the three status buttons. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imgWidgetMealIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/icon_background_green"
            android:contentDescription="@string/meal"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_meal" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Current meal based on time of day, with a small check right
                     after the name once that slot is already logged today, and
                     the day's "x/4" count on the right. The provider toggles
                     the check visibility. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtWidgetCurrentMeal"
                            style="@style/widgetTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/widget_current_meal_preview" />

                        <ImageView
                            android:id="@+id/imgWidgetCurrentMealCheck"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="4dp"
                            android:contentDescription="@string/widget_meal_added"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_check" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtWidgetMealCount"
                        style="@style/widgetTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_meal_preview_count" />
                </LinearLayout>
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal" >

                <TextView
                    android:id="@+id/btnWidgetCorrectMeal"
                    style="@style/widgetButton.Correct"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@string/correct_meal"
                    android:text="@string/correct_meal" />

                <TextView
                    android:id="@+id/btnWidgetWarningMeal"
                    style="@style/widgetButton.Warning"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@string/warning_meal"
                    android:text="@string/warning_meal" />

                <TextView
                    android:id="@+id/btnWidgetWrongMeal"
                    style="@style/widgetButton.Wrong"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:contentDescription="@string/wrong_meal"
                    android:text="@string/wrong_meal" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        style="@style/divider"
        android:layout_width="match_parent" />

    <!-- ===================== EXPENSE SECTION ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imgWidgetExpenseIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/icon_background_orange"
            android:contentDescription="@string/expenses"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_credit_card" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/txtWidgetExpenseLast"
                    style="@style/widgetTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@+id/txtWidgetExpenseTotal"
                    android:gravity="start"
                    android:textColor="@color/yellow_dark"
                    android:text="@string/widget_expense_preview_last" />

                <TextView
                    android:id="@+id/txtWidgetExpenseTotal"
                    style="@style/widgetTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:textColor="@color/yellow_dark"
                    android:text="@string/widget_expense_preview_total" />
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
