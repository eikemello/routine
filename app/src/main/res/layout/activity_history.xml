<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="85dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="20dp">

            <TextView
                style="@style/titleTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="24dp"
                android:text="@string/history" />

            <!-- Weekly Summary Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWeeklySummary"
                style="@style/MaterialCardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="visible">

                <LinearLayout
                    android:id="@+id/llWeeklySummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/txtSummaryTitle"
                        style="@style/titleTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/weekly_summary" />

                    <TextView
                        android:id="@+id/txtWeeklyWater"
                        style="@style/subTitleTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/weekly_water_default" />

                    <TextView
                        android:id="@+id/txtWeeklySpent"
                        style="@style/subTitleTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/weekly_spent_default" />

                    <TextView
                        android:id="@+id/txtWeeklyMeals"
                        style="@style/subTitleTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/weekly_meals_default" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Monthly Summary Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMonthlySummary"
                style="@style/MaterialCardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/llMonthlySummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/txtMonthlyTitle"
                        style="@style/titleTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/monthly_summary" />

                    <TextView
                        android:id="@+id/txtMonthlyWater"
                        style="@style/subTitleTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/weekly_water_default" />

                    <TextView
                        android:id="@+id/txtMonthlySpent"
                        style="@style/subTitleTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/weekly_spent_default" />

                    <TextView
                        android:id="@+id/txtMonthlyMeals"
                        style="@style/subTitleTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/weekly_meals_default" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- Calendar Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/MaterialCardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Calendar Header with Navigation -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPrevMonth"
                            style="@style/buttonTextStyle"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_alignParentStart="true"
                            android:gravity="center"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            android:text="@string/gt2"
                            android:textSize="20sp"
                            app:cornerRadius="12dp" />

                        <TextView
                            android:id="@+id/txtMonthYear"
                            style="@style/titleTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="1dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginEnd="1dp"
                            android:layout_toStartOf="@+id/btnNextMonth"
                            android:layout_toEndOf="@+id/btnPrevMonth"
                            android:textAlignment="center"
                            android:textSize="16sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnNextMonth"
                            style="@style/buttonTextStyle"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_alignParentEnd="true"
                            android:gravity="center"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            android:text="@string/gt"
                            android:textSize="20sp"
                            app:cornerRadius="12dp" />
                    </RelativeLayout>

                    <!-- Day Headers -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:orientation="horizontal"
                        android:weightSum="7">

                        <TextView
                            style="@style/calendarDayHeader"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/sun" />

                        <TextView
                            style="@style/calendarDayHeader"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/mon" />

                        <TextView
                            style="@style/calendarDayHeader"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/tue" />

                        <TextView
                            style="@style/calendarDayHeader"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/wed" />

                        <TextView
                            style="@style/calendarDayHeader"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/thu" />

                        <TextView
                            style="@style/calendarDayHeader"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/fri" />

                        <TextView
                            style="@style/calendarDayHeader"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/sat" />
                    </LinearLayout>

                    <!-- Calendar Grid -->
                    <GridLayout
                        android:id="@+id/calendarGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="7"
                        android:useDefaultMargins="false" />

                    <!-- Toggle View Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToggleView"
                        style="@style/buttonTextStyle"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:text="@string/month_view"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- Day Details Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/MaterialCardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/txtSelectedDate"
                            style="@style/titleTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_marginStart="4dp"
                            android:layout_marginTop="12dp"
                            android:layout_marginEnd="4dp"
                            android:layout_toStartOf="@+id/txtPrincipalDayScore"
                            android:textSize="16sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/txtPrincipalDayScore"
                            style="@style/buttonTextStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_alignParentEnd="true"
                            android:layout_marginEnd="4dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="60dp"
                            android:textSize="12sp"
                            app:cornerRadius="10dp" />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/txtNoData"
                        style="@style/subTitleTextView.Muted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/no_data_for_day"
                        android:visibility="gone" />

                    <GridLayout
                        android:id="@+id/dayDetailsGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:columnCount="2"
                        android:useDefaultMargins="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Score Breakdown Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/MaterialCardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <View
                        android:id="@+id/viewScoreStatus"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/calendar_day_background"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/txtScoreBreakdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/bottom_nav" />
</FrameLayout>
