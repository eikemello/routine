<?xml version="1.0" encoding="utf-8"?>
<!-- Expense card of the home screen: the header opens the history panel,
     the money spent in the cycle is the hero number over the limit, then one
     progress bar per configured card (or the single bar without cards). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/MaterialCardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/btnExpenseHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgCreditCard"
                style="@style/iconContainer"
                android:background="@drawable/icon_background"
                android:contentDescription="@string/expenses"
                android:src="@drawable/ic_credit_card"
                app:tint="@color/accent" />

            <LinearLayout
                android:id="@+id/middleRL"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtExpenses"
                    style="@style/titleTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/expenses" />

                <LinearLayout
                    android:id="@+id/expenseHistoryRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtLastExpenseRecord"
                        style="@style/subTitleTextView.Muted"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/last_expense" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/imgExpenseHistoryChevron"
                style="@style/rowChevron"
                android:contentDescription="@string/expense_history" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtTotalSpent"
                style="@style/heroNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/total_expense_value_init" />

            <TextView
                android:id="@+id/txtTrace"
                style="@style/heroUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/trace" />

            <TextView
                android:id="@+id/txtTotalValue"
                style="@style/heroUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/total_expense_value_init" />
        </LinearLayout>

        <!-- One progress bar per configured card is inflated here -->
        <LinearLayout
            android:id="@+id/cardProgressContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressExpense"
            style="@style/linearProgressBar.Expense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
