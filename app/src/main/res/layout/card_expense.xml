<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/MaterialCardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:id="@+id/btnExpenseHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:clickable="true">

            <ImageView
                android:id="@+id/imgCreditCard"
                style="@style/iconContainer"
                android:layout_height="48dp"
                android:background="@drawable/icon_background_orange"
                android:contentDescription="@string/expenses"
                android:src="@drawable/ic_credit_card"
                app:tint="@color/neon_orange" />

            <RelativeLayout
                android:id="@+id/middleRL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_toEndOf="@id/imgCreditCard">

                <TextView
                    android:id="@+id/txtExpenses"
                    style="@style/titleTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/expenses" />

                <TextView
                    android:id="@+id/txtLastExpenseRecord"
                    style="@style/subTitleTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/txtExpenses"
                    android:layout_marginBottom="8dp"
                    android:text="@string/last_expense" />

                <TextView
                    android:id="@+id/txtTotalSpent"
                    style="@style/textViewCardInfo.Warning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@id/txtTrace"
                    android:text="@string/total_expense_value_init"
                    android:textAlignment="textEnd" />

                <TextView
                    android:id="@+id/txtTrace"
                    style="@style/textViewCardInfo.Warning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@id/txtTotalValue"
                    android:text="@string/trace" />

                <TextView
                    android:id="@+id/txtTotalValue"
                    style="@style/textViewCardInfo.Warning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="@string/total_expense_value_init" />
            </RelativeLayout>

        </RelativeLayout>

        <!-- One progress bar per configured card is inflated here -->
        <LinearLayout
            android:id="@+id/cardProgressContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:orientation="vertical" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp">

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressExpense"
                style="@style/linearProgressBar.Expense"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />
        </FrameLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>