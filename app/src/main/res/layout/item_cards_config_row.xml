<?xml version="1.0" encoding="utf-8"?>
<!-- One configured card inside the Expenses group of Config: the bank and
     its last digits, the closing day under them and a chevron (tapping it
     opens the cards editor). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/settingRow">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtCardBank"
                style="@style/settingRowLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1" />

            <TextView
                android:id="@+id/txtCardLastFour"
                style="@style/settingRowLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtCardClosingDay"
            style="@style/subTitleTextView.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <ImageView
        style="@style/rowChevron"
        android:contentDescription="@string/card_statement_closing" />

</LinearLayout>
