<?xml version="1.0" encoding="utf-8"?>
<!-- Meal card of the home screen: the header opens the history panel, the
     four slot bars show the regular meals already logged today (painted with
     their status by HomeActivity) and the tonal status buttons log a meal. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/MaterialCardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/btnMealHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/imgViewMeal"
                style="@style/iconContainer"
                android:background="@drawable/icon_background"
                android:contentDescription="@string/meal"
                android:src="@drawable/ic_meal"
                app:tint="@color/accent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/titleTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/meal" />

                <TextView
                    android:id="@+id/txtMealSlotsSummary"
                    style="@style/subTitleTextView.Muted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/how_was_your_meal" />
            </LinearLayout>

            <ImageView
                android:id="@+id/imgMealHistoryChevron"
                style="@style/rowChevron"
                android:contentDescription="@string/meal_history" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mealSlotsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <View
                    android:id="@+id/viewMealSlot1"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:background="@drawable/progress_segment_background" />

                <TextView
                    style="@style/subTitleTextView.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/breakfast"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical">

                <View
                    android:id="@+id/viewMealSlot2"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:background="@drawable/progress_segment_background" />

                <TextView
                    style="@style/subTitleTextView.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/lunch"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical">

                <View
                    android:id="@+id/viewMealSlot3"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:background="@drawable/progress_segment_background" />

                <TextView
                    style="@style/subTitleTextView.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/tea"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical">

                <View
                    android:id="@+id/viewMealSlot4"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:background="@drawable/progress_segment_background" />

                <TextView
                    style="@style/subTitleTextView.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/dinner"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCorrectMeal"
                style="@style/buttonTextStyle.MealOption"
                app:icon="@drawable/ic_check"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/correct_meal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWarningMeal"
                style="@style/buttonTextStyle.MealOption"
                app:icon="@drawable/ic_warning"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/warning_meal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWrongMeal"
                style="@style/buttonTextStyle.MealOption"
                app:icon="@drawable/ic_close"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/wrong_meal" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
