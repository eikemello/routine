<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen: the date and greeting sit straight on the background with
     the ring of today's score at their end, then the week strip and the
     tracker cards under the "Today" label. The list scrolls under the floating bottom nav
     (bottom padding + clipToPadding off), instead of stopping above it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_background">

    <ScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="112dp"
        android:scrollbars="none"
        tools:context=".MainActivity">

        <LinearLayout
            android:id="@+id/mainLinearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <RelativeLayout
                android:id="@+id/mainRelativeLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="56dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <!-- Ring of today's score (same percentage as History) -->
                <FrameLayout
                    android:id="@+id/dayScoreRing"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progressDayScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:max="100"
                        app:indicatorColor="@color/accent"
                        app:indicatorSize="60dp"
                        app:trackColor="@color/accent_deep"
                        app:trackCornerRadius="3dp"
                        app:trackThickness="6dp" />

                    <TextView
                        android:id="@+id/txtDayScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/day_score_empty"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/txtCurrentDate"
                    style="@style/sectionLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:layout_marginEnd="12dp"
                    android:layout_toStartOf="@id/dayScoreRing" />

                <TextView
                    android:id="@+id/txtCurrentGreeting"
                    style="@style/menuTitleTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_below="@id/txtCurrentDate"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="12dp"
                    android:layout_toStartOf="@id/dayScoreRing" />
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/weekPreviewStrip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal" />

            <TextView
                style="@style/sectionLabel.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                android:text="@string/home_today_section" />

            <LinearLayout
                android:id="@+id/trackerCardsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/bottom_nav" />
</FrameLayout>
