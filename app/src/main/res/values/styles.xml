<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="MaterialCardView">
        <item name="android:layout_marginTop">15dp</item>
        <item name="cardBackgroundColor">#232222</item>
        <item name="strokeColor">#807F7F</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="titleTextView">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="subTitleTextView">
        <item name="android:textColor">#D5D4D4</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="buttonTextStyle">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">18sp</item>
        <item name="backgroundTint">#884B4848</item>
    </style>

    <style name="expenseTextViewInfo">
        <item name="android:textColor">#D5D4D4</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="menuTitleTextView">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="calendarDayHeader">
        <item name="android:textColor">#D5D4D4</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="calendarDayCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">45dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_gravity">fill_horizontal</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:background">@drawable/calendar_day_background</item>
    </style>

    <style name="linearProgressBar">
        <item name="indicatorColor">#3599FF</item>
        <item name="indicatorDirectionCircular">clockwise</item>
        <item name="indicatorSize">70dp</item>
        <item name="trackColor">#E3E3E3</item>
        <item name="trackCornerRadius">8dp</item>
        <item name="trackThickness">5dp</item>
    </style>

    <style name="textViewCardInfo">
        <item name="android:textColor">#3599FF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
