<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ==================== CARD STYLES ==================== -->

    <style name="MaterialCardView">
        <item name="android:layout_marginTop">15dp</item>
        <item name="android:layout_marginStart">5dp</item>
        <item name="android:layout_marginEnd">5dp</item>
        <item name="cardBackgroundColor">@color/glass_background</item>
        <item name="cardCornerRadius">20dp</item>
        <!--        <item name="cardElevation">10dp</item>-->
        <item name="cardMaxElevation">15dp</item>
        <item name="strokeColor">@color/glass_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/white_33</item>
    </style>

    <style name="MaterialCardView.Glass">
        <item name="cardBackgroundColor">@color/white_15</item>
        <item name="cardCornerRadius">25dp</item>
        <item name="strokeColor">@color/white_30</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="MaterialCardView.Highlight">
        <item name="cardBackgroundColor">@color/gradient_accent_1A</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="strokeColor">@color/neon_blue_30</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

    <!-- ==================== TEXT STYLES ==================== -->

    <style name="titleTextView">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="titleTextView.Accent">
        <item name="android:textColor">@color/neon_blue</item>
    </style>

    <style name="subTitleTextView">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="subTitleTextView.Muted">
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="menuTitleTextView">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="textViewCardInfo">
        <item name="android:textColor">@color/neon_blue</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="textViewCardInfo.Success">
        <item name="android:textColor">@color/green_dark</item>
    </style>

    <style name="textViewCardInfo.Warning">
        <item name="android:textColor">@color/yellow_dark</item>
    </style>

    <style name="textViewCardInfo.Danger">
        <item name="android:textColor">@color/red_dark</item>
    </style>

    <style name="expenseTextViewInfo">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- ==================== BUTTON STYLES ==================== -->

    <style name="buttonTextStyle">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/button_glass</item>
        <item name="cornerRadius">14dp</item>
        <item name="elevation">4dp</item>
        <item name="rippleColor">@color/white_40</item>
    </style>
    <style name="buttonTextStyle.Water">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetLeft">4dp</item>
        <item name="android:insetRight">4dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">9sp</item>
        <item name="android:autoSizeMaxTextSize">15sp</item>
        <item name="android:autoSizeStepGranularity">0.5sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/button_glass</item>
        <item name="cornerRadius">14dp</item>
        <item name="elevation">4dp</item>
        <item name="rippleColor">@color/white_40</item>
    </style>

    <style name="buttonTextStyle.Primary">
        <item name="backgroundTint">@color/gradient_accent</item>
        <item name="cornerRadius">16dp</item>
        <item name="elevation">6dp</item>
    </style>

    <style name="buttonTextStyle.Correct">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="strokeColor">@color/green_dark</item>
        <item name="strokeWidth">2dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetLeft">4dp</item>
        <item name="android:insetRight">4dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">9sp</item>
        <item name="android:autoSizeMaxTextSize">15sp</item>
        <item name="android:autoSizeStepGranularity">0.5sp</item>
    </style>

    <style name="buttonTextStyle.Warning">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="strokeColor">@color/yellow_dark</item>
        <item name="strokeWidth">2dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetLeft">4dp</item>
        <item name="android:insetRight">4dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">9sp</item>
        <item name="android:autoSizeMaxTextSize">15sp</item>
        <item name="android:autoSizeStepGranularity">0.5sp</item>
    </style>

    <style name="buttonTextStyle.Wrong">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="strokeColor">@color/red_dark</item>
        <item name="strokeWidth">2dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetLeft">4dp</item>
        <item name="android:insetRight">4dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">9sp</item>
        <item name="android:autoSizeMaxTextSize">15sp</item>
        <item name="android:autoSizeStepGranularity">0.5sp</item>
    </style>

    <!-- ==================== CALENDAR STYLES ==================== -->

    <style name="calendarDayHeader">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="calendarDayCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">45dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_gravity">fill_horizontal</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:background">@drawable/calendar_day_background</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- ==================== PROGRESS STYLES ==================== -->

    <style name="linearProgressBar">
        <item name="indicatorColor">@color/progress_indicator</item>
        <item name="indicatorDirectionCircular">clockwise</item>
        <item name="indicatorSize">70dp</item>
        <item name="trackColor">@color/progress_track</item>
        <item name="trackCornerRadius">8dp</item>
        <item name="trackThickness">6dp</item>
    </style>

    <style name="linearProgressBar.Water">
        <item name="indicatorColor">@color/neon_blue</item>
        <item name="trackColor">@color/neon_blue_1A</item>
        <item name="trackThickness">8dp</item>
    </style>

    <style name="linearProgressBar.Expense">
        <item name="indicatorColor">@color/neon_orange</item>
        <item name="trackColor">@color/neon_orange_1A</item>
        <item name="trackThickness">8dp</item>
    </style>

    <!-- ==================== ICON CONTAINER STYLES ==================== -->

    <style name="iconContainer">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/icon_background</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <!-- ==================== NAVIGATION STYLES ==================== -->

    <style name="bottomNavItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <!-- ==================== DIVIDER ==================== -->

    <style name="divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/white_15</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <!-- ==================== DIALOGS ==================== -->

    <!-- The dialog content views are hardcoded dark (surface_dark cards,
         white text), so dialogs must keep the dark palette regardless of the
         system DayNight theme - otherwise the light theme renders a white
         window with a dark title on top of dark content. -->
    <style name="ThemeOverlay.Routine.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorPrimary">@color/neon_blue</item>
        <item name="colorError">@color/red_dark</item>
    </style>

    <!-- ==================== HOME SCREEN WIDGETS ====================
         The widgets are inflated by the launcher through RemoteViews, which only
         knows framework views and resolves concrete resources, so these styles
         avoid Material-only attributes (backgroundTint, cornerRadius, ...).
         Sized for the compact 2x2 default: it stretches cleanly when resized. -->

    <style name="widgetTotal">
        <item name="android:textColor">@color/neon_blue</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="widgetGoal">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- The three quick-add buttons: one third of the width each, sharing the
         leftover height of the widget, with the glass background of the home
         card buttons. The text auto-shrinks so "+ 250" fits even in the
         narrow cells of the 2x2 size. -->
    <style name="widgetButton">
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/widget_button_background</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">1dp</item>
        <item name="android:paddingEnd">1dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">8sp</item>
        <item name="android:autoSizeMaxTextSize">13sp</item>
        <item name="android:autoSizeStepGranularity">0.5sp</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- The four meal slot buttons: the same row pattern as the water
         quick-add buttons, one per regular slot. Gray while the slot is empty;
         the provider swaps the text color and the background to the status
         color once the meal is logged. -->
    <style name="widgetButton.Meal" parent="widgetButton">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- The meal widget status buttons: a row of three mirroring the water
         quick-add row (each one a third of the width, stretching with the
         widget), keeping the identity of the home meal card buttons - glass
         background with the status stroke and the status label (Correct /
         Warning / Wrong) instead of the plain white text of the water buttons.
         The size and auto-sizing text are inherited from widgetButton. -->
    <style name="widgetButton.Correct" parent="widgetButton">
        <item name="android:textColor">@color/green_dark</item>
        <item name="android:background">@drawable/widget_button_correct</item>
    </style>

    <style name="widgetButton.Warning" parent="widgetButton">
        <item name="android:textColor">@color/yellow_dark</item>
        <item name="android:background">@drawable/widget_button_warning</item>
    </style>

    <style name="widgetButton.Wrong" parent="widgetButton">
        <item name="android:textColor">@color/red_dark</item>
        <item name="android:background">@drawable/widget_button_wrong</item>
    </style>

</resources>
