<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="MaterialCardView">
        <item name="android:layout_marginTop">15dp</item>
        <item name="cardBackgroundColor">#232222</item>
        <item name="strokeColor">#807F7F</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="titleTextView">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="subTitleTextView">
        <item name="android:textColor">#D5D4D4</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="buttonTextStyle">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">18sp</item>
        <item name="backgroundTint">#884B4848</item>
    </style>

    <style name="expenseTextViewInfo">
        <item name="android:textColor">#D5D4D4</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="menuTitleTextView">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>