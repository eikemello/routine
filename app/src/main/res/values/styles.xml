<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ==================== CARD STYLES ====================
         Cards are solid surfaces (surface_1) told apart from the screen by
         tone only - no border, no shadow. Use a card for a block the user
         acts on (a tracker card, a grouped list); plain sections (titles,
         labels, strips) sit straight on the background. -->

    <style name="MaterialCardView">
        <item name="android:layout_marginTop">12dp</item>
        <item name="cardBackgroundColor">@color/surface_1</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardMaxElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="rippleColor">@color/white_10</item>
    </style>

    <!-- A grouped list (Config, Trackers): rows separated by inset dividers
         inside one surface, with the section label above it. -->
    <style name="MaterialCardView.Group">
        <item name="android:layout_marginTop">0dp</item>
        <item name="cardCornerRadius">20dp</item>
    </style>

    <!-- A block inside a card or dialog (cells, inputs, the day details):
         one step lighter than the card it sits on. -->
    <style name="MaterialCardView.Inner">
        <item name="android:layout_marginTop">0dp</item>
        <item name="cardBackgroundColor">@color/surface_2</item>
        <item name="cardCornerRadius">16dp</item>
    </style>

    <style name="MaterialCardView.Glass">
        <item name="cardBackgroundColor">@color/surface_2</item>
        <item name="cardCornerRadius">24dp</item>
    </style>

    <style name="MaterialCardView.Highlight">
        <item name="cardBackgroundColor">@color/accent_deep</item>
        <item name="cardCornerRadius">24dp</item>
    </style>

    <!-- ==================== TEXT STYLES ==================== -->

    <!-- Card / dialog title. Screen titles use screenTitle. -->
    <style name="titleTextView">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="titleTextView.Accent">
        <item name="android:textColor">@color/accent</item>
    </style>

    <!-- The big title at the top of a screen (Config, History, ...). -->
    <style name="screenTitle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- Small uppercase label: the eyebrow above a screen title and the
         label above a section or grouped list. -->
    <style name="sectionLabel">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="sectionLabel.Section">
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:layout_marginStart">4dp</item>
    </style>

    <style name="subTitleTextView">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="subTitleTextView.Muted">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- The greeting of the home screen. -->
    <style name="menuTitleTextView">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="textViewCardInfo">
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="textViewCardInfo.Success">
        <item name="android:textColor">@color/status_good</item>
    </style>

    <style name="textViewCardInfo.Warning">
        <item name="android:textColor">@color/status_warning</item>
    </style>

    <style name="textViewCardInfo.Danger">
        <item name="android:textColor">@color/status_bad</item>
    </style>

    <!-- The main number of a card (water drunk, money spent). -->
    <style name="heroNumber">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- The unit/goal next to a hero number ("/ 3000 ml"). -->
    <style name="heroUnit">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="expenseTextViewInfo">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- ==================== BUTTON STYLES ====================
         Tonal pills: a soft fill of the accent with the accent as text, no
         stroke and no shadow. The neutral base is for actions without a
         color of their own. -->

    <style name="buttonTextStyle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="backgroundTint">@color/surface_3</item>
        <item name="cornerRadius">22dp</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">@color/white_15</item>
    </style>

    <!-- Shared by the buttons sitting three in a row: no minimum width and the
         text shrinking instead of wrapping. -->
    <style name="buttonTextStyle.Row">
        <item name="android:minWidth">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">9sp</item>
        <item name="android:autoSizeMaxTextSize">14sp</item>
        <item name="android:autoSizeStepGranularity">0.5sp</item>
    </style>

    <!-- Neutral tonal buttons: the accent text over its deep tone. -->
    <style name="buttonTextStyle.Water" parent="buttonTextStyle.Row">
        <item name="android:textColor">@color/accent</item>
        <item name="backgroundTint">@color/accent_deep</item>
        <item name="rippleColor">@color/white_20</item>
    </style>

    <style name="buttonTextStyle.Primary">
        <item name="android:textColor">@color/accent</item>
        <item name="backgroundTint">@color/accent_deep</item>
        <item name="rippleColor">@color/white_20</item>
    </style>

    <!-- The main action of a dialog or screen: the solid accent. -->
    <style name="buttonTextStyle.Filled">
        <item name="android:textColor">@color/background</item>
        <item name="backgroundTint">@color/accent</item>
        <item name="rippleColor">@color/white_40</item>
    </style>

    <!-- The Correct / Warning / Wrong options of the meal card: neutral like
         every control and told apart by their icon; the status color only
         shows up on the slot bars once the meal is logged. -->
    <style name="buttonTextStyle.MealOption" parent="buttonTextStyle.Row">
        <item name="android:textColor">@color/accent</item>
        <item name="backgroundTint">@color/accent_deep</item>
        <item name="rippleColor">@color/white_20</item>
        <item name="iconTint">@color/accent</item>
        <item name="iconSize">16dp</item>
        <item name="iconPadding">4dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <!-- Status tonal buttons: the vivid status text over its deep tone. -->
    <style name="buttonTextStyle.Correct" parent="buttonTextStyle.Row">
        <item name="android:textColor">@color/status_good</item>
        <item name="backgroundTint">@color/status_good_deep</item>
        <item name="rippleColor">@color/white_20</item>
    </style>

    <style name="buttonTextStyle.Warning" parent="buttonTextStyle.Row">
        <item name="android:textColor">@color/status_warning</item>
        <item name="backgroundTint">@color/status_warning_deep</item>
        <item name="rippleColor">@color/white_20</item>
    </style>

    <style name="buttonTextStyle.Wrong" parent="buttonTextStyle.Row">
        <item name="android:textColor">@color/status_bad</item>
        <item name="backgroundTint">@color/status_bad_deep</item>
        <item name="rippleColor">@color/white_20</item>
    </style>

    <!-- The "mark done" pill of each routine card: neutral, like every
         control; the green only shows up once the routine is done. -->
    <style name="buttonTextStyle.Routine">
        <item name="android:textColor">@color/accent</item>
        <item name="backgroundTint">@color/accent_deep</item>
        <item name="rippleColor">@color/white_20</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textSize">13sp</item>
        <item name="cornerRadius">20dp</item>
    </style>

    <!-- ==================== CALENDAR STYLES ==================== -->

    <style name="calendarDayHeader">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="calendarDayCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_gravity">fill_horizontal</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:background">@drawable/calendar_day_background</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- ==================== PROGRESS STYLES ==================== -->

    <style name="linearProgressBar">
        <item name="indicatorColor">@color/accent</item>
        <item name="trackColor">@color/accent_deep</item>
        <item name="trackCornerRadius">5dp</item>
        <item name="trackThickness">10dp</item>
    </style>

    <style name="linearProgressBar.Water">
        <item name="indicatorColor">@color/accent</item>
        <item name="trackColor">@color/accent_deep</item>
    </style>

    <style name="linearProgressBar.Expense">
        <item name="indicatorColor">@color/accent</item>
        <item name="trackColor">@color/accent_deep</item>
        <item name="trackThickness">8dp</item>
        <item name="trackCornerRadius">4dp</item>
    </style>

    <!-- ==================== ICON CONTAINER STYLES ==================== -->

    <style name="iconContainer">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/icon_background</item>
        <item name="android:padding">9dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <!-- ==================== LIST ROWS ==================== -->

    <!-- One row of a grouped list: label on the left, value/chevron on the
         right, the whole row tappable. -->
    <style name="settingRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="settingRowLabel">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="rowChevron">
        <item name="android:layout_width">16dp</item>
        <item name="android:layout_height">16dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:alpha">0.5</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:src">@drawable/ic_chevron_right</item>
        <item name="tint">@color/text_primary</item>
    </style>

    <!-- ==================== NAVIGATION STYLES ==================== -->

    <style name="bottomNavItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <!-- The icon of a bottom nav item: drawn inside the pill indicator that
         lights up when the item is selected (the helper propagates the
         selected state to the icon). -->
    <style name="bottomNavIcon">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/bottom_nav_indicator</item>
    </style>

    <style name="bottomNavLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- ==================== DIVIDER ==================== -->

    <style name="divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/outline_subtle</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <!-- Divider between the rows of a grouped list: inset from the start and
         flush with the rows (they carry their own padding). -->
    <style name="divider.Inset">
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginTop">0dp</item>
        <item name="android:layout_marginBottom">0dp</item>
    </style>

    <!-- ==================== FILTERS (All data) ==================== -->

    <style name="Widget.Routine.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_filter_background</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">18dp</item>
        <item name="android:textColor">@color/chip_filter_text</item>
        <item name="checkedIconTint">@color/accent</item>
        <item name="rippleColor">@color/white_10</item>
    </style>

    <!-- The search box: a filled field on the card surface, no underline,
         rounded like the cards; the hint is a plain placeholder. -->
    <style name="Widget.Routine.SearchField" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/surface_1</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="hintEnabled">false</item>
        <item name="startIconTint">@color/text_muted</item>
        <item name="endIconTint">@color/text_muted</item>
    </style>

    <!-- One of the Date range / Category / Type buttons of All data. -->
    <style name="filterButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>
        <item name="cardBackgroundColor">@color/surface_1</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="rippleColor">@color/white_10</item>
    </style>

    <!-- ==================== DIALOGS ==================== -->

    <!-- The dialog content views are hardcoded dark (surface_dark cards,
         white text), so dialogs must keep the dark palette regardless of the
         system DayNight theme - otherwise the light theme renders a white
         window with a dark title on top of dark content. -->
    <style name="ThemeOverlay.Routine.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorError">@color/status_bad</item>
    </style>

    <!-- ==================== HOME SCREEN WIDGETS ====================
         The widgets are inflated by the launcher through RemoteViews, which only
         knows framework views and resolves concrete resources, so these styles
         avoid Material-only attributes (backgroundTint, cornerRadius, ...).
         Sized for the compact 2x2 default: it stretches cleanly when resized. -->

    <style name="widgetTotal">
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="widgetGoal">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- The three quick-add buttons: one third of the width each, sharing the
         leftover height of the widget, with the glass background of the home
         card buttons. The text auto-shrinks so "+ 250" fits even in the
         narrow cells of the 2x2 size. -->
    <style name="widgetButton">
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/widget_button_background</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">1dp</item>
        <item name="android:paddingEnd">1dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">8sp</item>
        <item name="android:autoSizeMaxTextSize">13sp</item>
        <item name="android:autoSizeStepGranularity">0.5sp</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- The four meal slot buttons: the same row pattern as the water
         quick-add buttons, one per regular slot. Gray while the slot is empty;
         the provider swaps the text color and the background to the status
         color once the meal is logged. -->
    <style name="widgetButton.Water" parent="widgetButton">
        <item name="android:textColor">@color/accent</item>
        <item name="android:background">@drawable/widget_button_water</item>
    </style>

    <style name="widgetButton.Meal" parent="widgetButton">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- The meal widget status buttons: a row of three mirroring the water
         quick-add row (each one a third of the width, stretching with the
         widget), keeping the identity of the home meal card buttons - glass
         background with the status stroke and the status label (Correct /
         Warning / Wrong) instead of the plain white text of the water buttons.
         The size and auto-sizing text are inherited from widgetButton. -->
    <style name="widgetButton.Correct" parent="widgetButton">
        <item name="android:textColor">@color/status_good</item>
        <item name="android:background">@drawable/widget_button_correct</item>
    </style>

    <style name="widgetButton.Warning" parent="widgetButton">
        <item name="android:textColor">@color/status_warning</item>
        <item name="android:background">@drawable/widget_button_warning</item>
    </style>

    <style name="widgetButton.Wrong" parent="widgetButton">
        <item name="android:textColor">@color/status_bad</item>
        <item name="android:background">@drawable/widget_button_wrong</item>
    </style>

    <!-- The done control of the routines widget: the glass background of the
         widget buttons, filling the width of the tile under the routine name.
         While the routine is open the provider shows the label ("Done"); once
         the day is marked it hides the label and shows the green check inside
         the same box. The size and auto-sizing text are inherited from
         widgetButton (the weight is dropped: the label sits in a frame). -->
    <style name="widgetButton.TrackerDone" parent="widgetButton">
        <item name="android:layout_weight">0</item>
        <item name="android:minHeight">28dp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

</resources>
