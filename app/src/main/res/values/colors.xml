    <!-- ==================== STATUS / SEMANTIC COLORS ====================
         Single source of truth for the app's status colors:
           GREEN  = goal achieved / correct meal / completed / day score good
           YELLOW = warning meal / partial goal / day score warning
           RED    = wrong meal / over budget / day score bad
         These tokens are used in text, calendar day cells and the principal
         day score pill so they always match. Change them here and everything
         updates everywhere. -->
    <color name="green">#39FF14</color>
    <color name="yellow">#FFD700</color>
    <color name="red">#FF3131</color>

