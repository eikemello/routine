<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- ==================== PALETTE ("status only") ====================
         The interface is monochrome; the only hues on screen are the three
         status colors, so color always means "how did it go".
         Every color comes as a pair:
           <name>_deep -> the base: track, tonal button fill, day cell fill
           <name>      -> what sits on top of it: indicator, text, icon, number
         A vivid color is never used alone on a large area, always over its
         own deep tone (e.g. the day ring: status_bad_deep track +
         status_bad arc).
           accent  = neutral controls (buttons, progress, nav, icons)
           good    = goal reached / correct meal / completed / day >= 85%
           warning = warning meal / partial / day >= 55%
           bad     = wrong meal / over budget / day < 55% -->
    <color name="accent">#E8E8EE</color>
    <color name="accent_deep">#262633</color>
    <color name="status_good">#5BE03A</color>
    <color name="status_good_deep">#163A14</color>
    <color name="status_warning">#F0BE3A</color>
    <color name="status_warning_deep">#3B2F10</color>
    <color name="status_bad">#FF6B6B</color>
    <color name="status_bad_deep">#401A1D</color>

    <!-- ==================== BASE / SURFACES ====================
         Solid layers, told apart by tone instead of outlines:
           background -> the screen
           surface_1  -> cards and grouped lists
           surface_2  -> elements inside a card (inputs, chips, cells)
           surface_3  -> pressed / neutral buttons on top of surface_2 -->
    <color name="background">#0B0B12</color>
    <color name="surface_1">#15151E</color>
    <color name="surface_2">#1D1D28</color>
    <color name="surface_3">#262633</color>
    <color name="surface_dark">#17171F</color>
    <color name="surface_input">#1D1D28</color>
    <color name="outline_subtle">#12FFFFFF</color>
    <!-- Dims the screen behind the side menu -->
    <color name="side_menu_scrim">#99000000</color>
    <color name="bottom_nav_start">#1A1A24</color>

    <!-- ==================== TEXT ==================== -->
    <color name="text_primary">#FFFFFF</color>
    <color name="text_secondary">#D1D5DB</color>
    <color name="text_tertiary">#9CA3AF</color>
    <color name="text_muted">#8A8A99</color>

    <!-- ==================== TRANSLUCENT WHITE ====================
         Naming: white_<alphaHex>. Ripples, hairlines and soft glows. -->
    <color name="white_08">#08FFFFFF</color>
    <color name="white_10">#10FFFFFF</color>
    <color name="white_15">#15FFFFFF</color>
    <color name="white_20">#20FFFFFF</color>
    <color name="white_30">#30FFFFFF</color>
    <color name="white_33">#33FFFFFF</color>
    <color name="white_40">#40FFFFFF</color>
</resources>
